classDiagram
direction LR
class Account {
  <<model>>
  +ObjectId _id
  +String email
  +String displayName
  +String status
}
class Story {
  <<model>>
  +ObjectId _id
  +ObjectId authorAccountId
  +String publicationStatus
  +ObjectId publishedRevisionId
}
class Chapter {
  <<model>>
  +ObjectId _id
  +ObjectId storyId
  +String status
  +ObjectId publishedRevisionId
  +Object earlyAccess
}
class ContentRevision {
  <<model>>
  +ObjectId _id
  +String contentType
  +String status
  +Object content
}
class Wallet {
  <<model>>
  +ObjectId _id
  +String ownerType
  +ObjectId ownerId
  +String purpose
  +String unit
  +Number availableBalance
  +Number balanceVersion
}
class LedgerEntry {
  <<model>>
  +ObjectId _id
  +ObjectId walletId
  +String ledgerType
  +String direction
  +Number amount
  +String sourceType
  +ObjectId sourceId
  +Object idempotencyScope
  +Date occurredAt
}
class TopUpPackage {
  <<model>>
  +ObjectId _id
  +Number priceVnd
  +Number coinAmount
  +String status
}
class TopUpOrder {
  <<model>>
  +ObjectId _id
  +ObjectId accountId
  +ObjectId walletId
  +ObjectId packageId
  +Object packageSnapshot
  +String paymentCode
  +Number coinAmount
  +String status
  +Date expiresAt
  +ObjectId bankTransactionId
}
class BankTransaction {
  <<model>>
  +ObjectId _id
  +String sePayTransactionId
  +Number amountVnd
  +String extractedPaymentCode
  +String matchStatus
  +ObjectId matchedOrderId
