        </mxCell>
        <mxCell id="127" value="Sơ đồ con là mở rộng cùng một lời gọi ở trang 01, không thực hiện thêm một lần mua. Transaction còn bao gồm các kiểm tra và ghi version ở trang 03. | ref mở rộng cùng thao tác, không chạy thêm lần nữa. Nét đứt: phản hồi. Thanh xanh: activation." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;fontColor=#172033;fontFamily=Arial;fontSize=13;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1">
