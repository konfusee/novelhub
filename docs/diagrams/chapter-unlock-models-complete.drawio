        <mxCell id="92" value="POST còn đi qua csrfProtection ở app.js. Khi có cookie, Origin không hợp lệ bị từ chối trước route. Các ghi lastSeen/revoke ở đây nằm ngoài transaction tiền." style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#172033;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="53" y="1518" width="1209" height="51" />
        </mxCell>
        <mxCell id="93" value="requireAuth() không gọi publicUser()/requireRole(), nên không tự thêm RoleAssignment vào nhánh mua. Người mua được lấy từ req.account, không từ body. | ref mở rộng cùng thao tác, không chạy thêm&#10;lần nữa. Nét đứt: phản hồi. Thanh xanh: activation." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;fontColor=#172033;fontFamily=Arial;fontSize=13;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1">
