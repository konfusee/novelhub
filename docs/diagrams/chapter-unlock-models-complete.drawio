        <mxCell id="142" value="Quote không giữ chỗ hoặc trừ xu. POST phải kiểm tra lại giá, revision và số dư vì chúng có thể đổi sau GET. Mọi kết quả quote đều private, no-store." style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#172033;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="53" y="2079" width="2199" height="51" />
        </mxCell>
        <mxCell id="143" value="Sau khi nhận quote: UI hiển thị giá/số dư; thiếu xu thì dẫn đến ví; đã có quyền thì tải lại nội dung. Tiền chưa bị thay đổi ở bước báo giá. | ref mở rộng cùng thao tác, không chạy thêm lần nữa. Nét đứt: phản hồi. Thanh xanh: activation." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;fontColor=#172033;fontFamily=Arial;fontSize=13;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1">
