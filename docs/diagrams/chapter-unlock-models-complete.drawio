        </mxCell>
        <mxCell id="193" value="Trang này chạy ngoài transaction mua. Lỗi tải nội dung không tự hoàn xu của giao dịch đã commit. Lỗi ghi lượt đọc được bắt và không làm hỏng việc đọc." style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#172033;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="53" y="2709" width="2859" height="51" />
        </mxCell>
        <mxCell id="194" value="Quyền đọc được kiểm tra ở backend mỗi lần lấy nội dung. Không chỉ dựa vào nút mở khóa hay state frontend. Các API ảnh riêng và ReadingProgress nằm ngoài phạm vi hình này. | ref mở rộng cùng thao tác, không chạy thêm lần nữa. Nét đứt: phản hồi. Thanh xanh: activation." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;fontColor=#172033;fontFamily=Arial;fontSize=13;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="2822" width="2835" height="86" />
        </mxCell>
