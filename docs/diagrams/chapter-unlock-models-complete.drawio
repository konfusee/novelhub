        <mxCell id="126" value="withTransaction() bên ngoài mới commit/abort. status=committed chỉ là trạng thái document, không phải lệnh commit MongoDB. Ledger và Allocation chỉ ghi nhận, không cộng/trừ số dư lần nữa." style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#172033;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1">
