        <mxCell id="148" value="Nhóm model thống kê này thuộc truy vấn catalog dùng chung. Chúng chỉ được đọc ở đây, không tham gia trừ/cộng xu. Không vẽ nhầm thành ghi tiền hay lớp repository mới." style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#172033;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="53" y="1959" width="3189" height="51" />
        </mxCell>
        <mxCell id="149" value="Phụ lục giữ các model phụ trợ đúng như code, để các trang mua chương chính không bị kéo thành một hình quá rộng. Không bổ sung RoleAssignment vì pipeline này không dùng model đó. | ref mở rộng cùng thao tác, không chạy thêm lần nữa. Nét đứt: phản hồi. Thanh xanh: activation." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;fontColor=#172033;fontFamily=Arial;fontSize=13;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1">
