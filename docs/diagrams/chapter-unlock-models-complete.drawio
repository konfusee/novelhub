        <mxCell id="105" value="Giá 1.000, tỷ lệ 70/30: reader −1.000; author +700; platform +300. Nếu phần nhận bằng 0 vẫn upsert ví nhưng bỏ lần $inc. Platform owner ID không phải account admin." style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#172033;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="53" y="1733" width="1539" height="51" />
        </mxCell>
        <mxCell id="106" value="Mọi query ở trang này có cùng session. Trả kết quả ở đây chưa commit. Không gọi ngân hàng hay SePay; đang chuyển xu nội bộ. | ref mở rộng cùng thao tác, không chạy thêm lần nữa. Nét đứt: phản hồi. Thanh xanh: activation." style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;fontColor=#172033;fontFamily=Arial;fontSize=13;align=center;verticalAlign=middle;spacing=8;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="1846" width="1515" height="86" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
