# Browser API path. Keep it relative for local development with session cookies.
VITE_API_BASE_URL=/api

# Vite dev/preview proxy target (server-only; no /api suffix).
# Local backend:
DEV_API_TARGET=http://localhost:4000
# Deployed backend through Cloudflare:
# DEV_API_TARGET=https://novelhub-api.maylink.net
