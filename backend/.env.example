# Cấu hình backend NovelHub
# Sao chép .env.example thành .env rồi điền thông tin riêng. .env được Git bỏ qua.
# Không gửi/commit Client Secret, mật khẩu SMTP hoặc URI có thông tin đăng nhập.

# ==================== 1. Máy chủ và log ====================
# NODE_ENV: development/test/production. PORT: cổng API. LOG_LEVEL: mức ghi log.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ==================== 2. Cơ sở dữ liệu ====================
# MongoDB phải là replica set để hỗ trợ transaction. URI thật chỉ lưu trong .env.
MONGODB_URI=mongodb://USERNAME:PASSWORD@HOST:27017/novelhub?authSource=admin
DB_SERVER_SELECTION_TIMEOUT_MS=10000

# ==================== 3. Frontend và CORS ====================
# FRONTEND_URL là địa chỉ frontend. CORS_ORIGIN là danh sách origin, phân cách bằng dấu phẩy; không có dấu / cuối.
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
HTTP_JSON_LIMIT_KB=1024

# ==================== 4. Phiên đăng nhập ====================
# Tên cookie không chứa khoảng trắng. Thời hạn phiên tính bằng ngày; cookie Secure tự bật ở production.
AUTH_COOKIE_NAME=novelhub_session
SESSION_TTL_DAYS=7

# ==================== 5. Email xác minh, OTP và chống thử liên tục ====================
# TTL tính bằng phút; thời gian gửi lại tính bằng giây. Mã OTP chỉ dùng một lần.
EMAIL_VERIFICATION_TTL_MINUTES=60
PASSWORD_RESET_TTL_MINUTES=30
SECURITY_CODE_TTL_MINUTES=10
AUTH_CODE_RESEND_SECONDS=60
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_RECOVERY_MAX_ATTEMPTS=30

# ==================== 6. CAPTCHA ====================
# Giới hạn số mã giữ trong bộ nhớ và số yêu cầu mỗi IP trong một phút.
CAPTCHA_TTL_MINUTES=5
CAPTCHA_MAX_ENTRIES=10000
CAPTCHA_MAX_REQUESTS=20

# ==================== 7. SMTP gửi email ====================
# Development: để trống toàn bộ HOST/USER/PASSWORD/FROM để dùng console. Production: bắt buộc đủ bốn giá trị.
# Cổng 587 dùng SMTP_SECURE=false (STARTTLS); cổng 465 dùng true. Timeout tính bằng mili giây.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000
EMAIL_SEND_ATTEMPTS=3

# ==================== 8. Google OAuth ====================
# Điền đồng thời CLIENT_ID, CLIENT_SECRET và REDIRECT_URI hoặc để trống cả ba. Secret chỉ nằm trong backend/.env.
# Local redirect URI: http://localhost:4000/api/auth/google/callback ; phải khớp Authorized redirect URIs trong Google Cloud.
# OAUTH_STATE_TTL_MINUTES: thời hạn state/PKCE; GOOGLE_HTTP_TIMEOUT_MS: timeout gọi Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
OAUTH_STATE_TTL_MINUTES=10
GOOGLE_HTTP_TIMEOUT_MS=10000

# ==================== 9. Tài khoản phát triển (tùy chọn) ====================
# Chỉ dùng với db:seed-dev-account; bị chặn trong production. Không commit email/mật khẩu thật.
DEV_SEED_EMAIL=
DEV_SEED_PASSWORD=
DEV_SEED_NAME=
