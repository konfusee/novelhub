# Copy to backend/.env for local development.
NODE_ENV=development
PORT=4000
# Ask the project owner for development credentials; never commit them.
MONGODB_URI=mongodb://USERNAME:PASSWORD@HOST:27017/novelhub?authSource=admin&directConnection=true
# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
AUTH_COOKIE_NAME=novelhub_session
SESSION_TTL_DAYS=7
FRONTEND_URL=http://localhost:5173
EMAIL_VERIFICATION_TTL_MINUTES=60
PASSWORD_RESET_TTL_MINUTES=30
# Optional in development; required in production. Leave all blank for console links.
# Port 587: SMTP_SECURE=false (required STARTTLS). Port 465: SMTP_SECURE=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Optional Google OAuth web client. Keep secrets only in backend/.env.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
