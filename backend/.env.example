# Cấu hình backend NovelHub
# Sao chép .env.example thành .env rồi điền thông tin riêng. .env được Git bỏ qua.
# Không gửi/commit Client Secret, mật khẩu SMTP hoặc URI có thông tin đăng nhập.

# ==================== 1. Máy chủ và log ====================
# NODE_ENV: development/test/production. PORT: cổng API. LOG_LEVEL: mức ghi log.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ==================== 2. Cơ sở dữ liệu ====================
# MongoDB phải là replica set để hỗ trợ transaction. URI thật chỉ lưu trong .env.
MONGODB_URI=mongodb://USERNAME:PASSWORD@HOST:27017/novelhub?authSource=admin
DB_SERVER_SELECTION_TIMEOUT_MS=10000

# ==================== 3. Frontend và CORS ====================
# FRONTEND_URL là địa chỉ frontend. CORS_ORIGIN là danh sách origin, phân cách bằng dấu phẩy; không có dấu / cuối.
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
HTTP_JSON_LIMIT_KB=1024

# ==================== 4. Phiên đăng nhập ====================
# Tên cookie không chứa khoảng trắng. Thời hạn phiên tính bằng ngày; cookie Secure tự bật ở production.
AUTH_COOKIE_NAME=novelhub_session
SESSION_TTL_DAYS=7

# ==================== 5. Email xác minh, OTP và chống thử liên tục ====================
# TTL tính bằng phút; thời gian gửi lại tính bằng giây. Mã OTP chỉ dùng một lần.
EMAIL_VERIFICATION_TTL_MINUTES=60
PASSWORD_RESET_TTL_MINUTES=30
SECURITY_CODE_TTL_MINUTES=10
AUTH_CODE_RESEND_SECONDS=60
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_RECOVERY_MAX_ATTEMPTS=30

# ==================== 6. CAPTCHA ====================
# Giới hạn số mã giữ trong bộ nhớ và số yêu cầu mỗi IP trong một phút.
CAPTCHA_TTL_MINUTES=5
CAPTCHA_MAX_ENTRIES=10000
CAPTCHA_MAX_REQUESTS=20

# ==================== 7. SMTP gửi email ====================
# Development: để trống toàn bộ HOST/USER/PASSWORD/FROM để dùng console. Production: bắt buộc đủ bốn giá trị.
# Cổng 587 dùng SMTP_SECURE=false (STARTTLS); cổng 465 dùng true. Timeout tính bằng mili giây.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=15000
EMAIL_SEND_ATTEMPTS=3

# ==================== 8. Google OAuth ====================
# Điền đồng thời CLIENT_ID, CLIENT_SECRET và REDIRECT_URI hoặc để trống cả ba. Secret chỉ nằm trong backend/.env.
# Local redirect URI: http://localhost:4000/api/auth/google/callback ; phải khớp Authorized redirect URIs trong Google Cloud.
# OAUTH_STATE_TTL_MINUTES: thời hạn state/PKCE; GOOGLE_HTTP_TIMEOUT_MS: timeout gọi Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
OAUTH_STATE_TTL_MINUTES=10
GOOGLE_HTTP_TIMEOUT_MS=10000

# ==================== 9. Tài khoản phát triển (tùy chọn) ====================
# Chỉ dùng với db:seed-dev-account; bị chặn trong production. Không commit email/mật khẩu thật.
DEV_SEED_EMAIL=
DEV_SEED_PASSWORD=
DEV_SEED_NAME=

# ==================== 10. Lưu ảnh tác giả (tùy chọn) ====================
# Đường dẫn tuyệt đối tới thư mục lưu bền, nằm ngoài thư mục public/build.
# Để trống dùng backend/uploads/media. Backup thư mục này cùng MongoDB.
# Ví dụ Windows: D:/NovelHubData/media ; Linux/container: /var/lib/novelhub/media
MEDIA_STORAGE_DIR=

# Webhook nhận tiền SePay: để trống cả hai để tắt. API key tối thiểu 32 ký tự.
TOPUP_BANK_BIN=
TOPUP_BANK_NAME=
TOPUP_BANK_ACCOUNT_NUMBER=
TOPUP_BANK_ACCOUNT_NAME=
SEPAY_WEBHOOK_API_KEY=

# ==================== 11. Kiểm duyệt và bằng chứng AI ====================
# MODERATION_CLAIM_HOURS: số giờ kiểm duyệt viên giữ hồ sơ; hết hạn thì hồ sơ quay lại hàng đợi.
MODERATION_CLAIM_HOURS=24
# Chỉ bật worker bằng chứng AI trên đúng một máy chạy được chỉ định. Mọi backend khác dùng chung cơ sở dữ liệu phải để false.
AI_EVIDENCE_WORKER_ENABLED=false
# OPENAI_API_KEY chỉ đặt trong backend/.env. Để trống thì worker bằng chứng AI không khởi động.
OPENAI_API_KEY=
# Model embedding, model đánh giá LLM, mức suy luận của model đánh giá và thời gian chờ mỗi lần gọi OpenAI (mili giây). Model phải có giá trong pricing.js.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_REVIEW_MODEL=gpt-6-luna
OPENAI_REVIEW_REASONING_EFFORT=low
OPENAI_TIMEOUT_MS=60000
# Chu kỳ quét bằng chứng AI (giây), số đoạn tương đồng cho mỗi đoạn truy vấn và tên vector index trên embeddingArtifacts.
AI_EVIDENCE_INTERVAL_SECONDS=30
SIMILARITY_TOP_K=5
VECTOR_SEARCH_INDEX=embedding_vectors
# Ngân sách OpenAI (USD) tính từ AI_BUDGET_WINDOW_START (ngày ISO; để trống là toàn bộ lịch sử). Hết ngân sách thì worker ngừng gọi OpenAI.
AI_BUDGET_USD=3
AI_BUDGET_WINDOW_START=

# ==================== 12. Đọc truyện bằng giọng nói (TTS - Vbee) ====================
# Lấy App ID và token (JWT) tại https://studio.vbee.vn/apps. Chỉ đặt trong backend/.env, không commit.
# Để trống cả hai thì chức năng nghe trả về "chưa sẵn sàng"; đọc văn bản không bị ảnh hưởng.
VBEE_APP_ID=
VBEE_TOKEN=
# Giọng đọc mặc định duy nhất (người đọc không chọn giọng). Đổi giọng sẽ tạo audio mới cho mỗi chương.
VBEE_VOICE_CODE=hn_female_hermer_stor_48k-fhg
VBEE_API_URL=https://api.vbee.vn/v1
VBEE_TIMEOUT_MS=20000
# URL công khai Vbee gọi lại khi tạo xong audio. Để trống thì dùng FRONTEND_URL + /api/tts/vbee/callback.
# Trên máy local Vbee không gọi lại được; backend vẫn tự hỏi trạng thái khi trình phát kiểm tra.
TTS_CALLBACK_URL=
# Giới hạn chi phí: số giây tối thiểu giữa hai lần một tài khoản khởi tạo audio mới (0 = tắt),
# và tổng số ký tự gửi Vbee mỗi ngày theo giờ Việt Nam cho toàn hệ thống (0 = không giới hạn).
# Mỗi chương tối đa 3 lần gửi Vbee; lỗi vĩnh viễn (nội dung bị từ chối, quá dài) không tạo lại.
TTS_REQUEST_COOLDOWN_SECONDS=30
TTS_DAILY_CHARACTER_LIMIT=200000

# Enable only on the designated backend. Never enable on a shared development DB by default.
PAYOUT_WORKER_ENABLED=false
